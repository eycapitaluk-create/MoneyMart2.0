{
  "functions": {
    "api/cron/*.js": {
      "maxDuration": 300
    },
    "api/ssr/*.js": {
      "maxDuration": 30
    },
    "api/*.js": {
      "maxDuration": 120
    }
  },
  "crons": [],
  "headers": [
    {
      "source": "/(login|signup|forgot-password|reset-password|complete-profile|signup-complete)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/mypage(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/business/demo",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/(community|lounge|signup-complete)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "^/sitemap\\.xml$",
      "dest": "/api/sitemap"
    },
    {
      "src": "^/funds/compare/?$",
      "status": 308,
      "headers": {
        "Location": "/etf-compare"
      }
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "^/admin(?:/(.*))?$",
      "has": [
        {
          "type": "cookie",
          "key": "mm_admin_basic",
          "value": "1"
        }
      ],
      "dest": "/index.html"
    },
    {
      "src": "^/admin/?$",
      "dest": "/api/admin/basic-auth?next=/admin"
    },
    {
      "src": "^/admin/(.*)$",
      "dest": "/api/admin/basic-auth?next=/admin/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/((?!api/|@|src/|node_modules/|assets/|vite\\.svg|favicon\\.ico).*)",
      "dest": "/index.html"
    }
  ]
}
