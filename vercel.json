{
  "functions": {
    "api/cron/*.js": {
      "maxDuration": 300
    },
    "api/ssr/*.js": {
      "maxDuration": 30
    },
    "api/*.js": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/cron/yahoo-unadjusted-daily?scope=us&batch=0&batches=6&start_date=2026-10-11",
      "schedule": "15 22 * * *"
    },
    {
      "path": "/api/cron/yahoo-unadjusted-daily?scope=us&batch=1&batches=6&start_date=2026-10-11",
      "schedule": "21 22 * * *"
    },
    {
      "path": "/api/cron/yahoo-unadjusted-daily?scope=us&batch=2&batches=6&start_date=2026-10-11",
      "schedule": "27 22 * * *"
    },
    {
      "path": "/api/cron/yahoo-unadjusted-daily?scope=us&batch=3&batches=6&start_date=2026-10-11",
      "schedule": "33 22 * * *"
    },
    {
      "path": "/api/cron/yahoo-unadjusted-daily?scope=us&batch=4&batches=6&start_date=2026-10-11",
      "schedule": "39 22 * * *"
    },
    {
      "path": "/api/cron/yahoo-unadjusted-daily?scope=us&batch=5&batches=6&start_date=2026-10-11",
      "schedule": "45 22 * * *"
    },
    {
      "path": "/api/cron/yahoo-unadjusted-daily?scope=jp&batch=0&batches=3&start_date=2026-10-11",
      "schedule": "51 22 * * *"
    },
    {
      "path": "/api/cron/yahoo-unadjusted-daily?scope=jp&batch=1&batches=3&start_date=2026-10-11",
      "schedule": "57 22 * * *"
    },
    {
      "path": "/api/cron/yahoo-unadjusted-daily?scope=jp&batch=2&batches=3&start_date=2026-10-11",
      "schedule": "3 23 * * *"
    },
    {
      "path": "/api/cron/yahoo-unadjusted-daily?scope=etf&batch=0&batches=4&start_date=2026-10-11",
      "schedule": "9 23 * * *"
    },
    {
      "path": "/api/cron/yahoo-unadjusted-daily?scope=etf&batch=1&batches=4&start_date=2026-10-11",
      "schedule": "15 23 * * *"
    },
    {
      "path": "/api/cron/yahoo-unadjusted-daily?scope=etf&batch=2&batches=4&start_date=2026-10-11",
      "schedule": "21 23 * * *"
    },
    {
      "path": "/api/cron/yahoo-unadjusted-daily?scope=etf&batch=3&batches=4&start_date=2026-10-11",
      "schedule": "27 23 * * *"
    },
    {
      "path": "/api/cron/yahoo-unadjusted-daily?scope=dashboard&start_date=2026-10-11",
      "schedule": "33 23 * * *"
    },
    {
      "path": "/api/cron/yahoo-unadjusted-daily?scope=fx&start_date=2026-10-11",
      "schedule": "15 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(login|signup|forgot-password|reset-password|complete-profile|signup-complete)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/mypage(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/business/demo",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/(community|lounge|signup-complete)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "^/sitemap\\.xml$",
      "dest": "/api/sitemap"
    },
    {
      "src": "^/funds/compare/?$",
      "status": 308,
      "headers": {
        "Location": "/etf-compare"
      }
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "^/admin(?:/(.*))?$",
      "has": [
        {
          "type": "cookie",
          "key": "mm_admin_basic",
          "value": "1"
        }
      ],
      "dest": "/index.html"
    },
    {
      "src": "^/admin/?$",
      "dest": "/api/admin/basic-auth?next=/admin"
    },
    {
      "src": "^/admin/(.*)$",
      "dest": "/api/admin/basic-auth?next=/admin/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/((?!api/|@|src/|node_modules/|assets/|vite\\.svg|favicon\\.ico).*)",
      "dest": "/index.html"
    }
  ]
}
